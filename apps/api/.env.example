# PostgreSQL Database Connection URL (Local or Cloud like Render, Supabase, Neon)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/jobanalytica?schema=public"

# App Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_jobanalytica_dev
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
